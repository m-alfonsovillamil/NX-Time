{"openapi":"3.1.0","info":{"title":"NX Time API","description":"API REST del backend de NX Time: registro horario (fichaje), gestión de ausencias y administración de empleados, multi-tenant por empresa.","contact":{"name":"NX Time"},"version":"v1"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Gestión","description":"Alta de empleados/gestores, listado del equipo y baja de empleados. Authorities distintas según GESTOR/RRHH/ADMIN, ver RoleAuthorities."},{"name":"Ausencias","description":"Solicitud de ausencias (vacaciones, bajas...) y su aprobación/rechazo por un gestor."},{"name":"Auditoría","description":"Línea temporal de cambios de un fichaje (RD-ley 8/2019). Solo lectura."},{"name":"Autenticación","description":"Registro de empresa, login, renovación y cierre de sesión. Público (sin token), pero limitado a 10 peticiones/minuto por IP en login y register-manager."},{"name":"Usuario","description":"Operaciones sobre el propio perfil del usuario autenticado."},{"name":"Dashboard","description":"Métricas agregadas: horas trabajadas, pendientes e incidencias."},{"name":"Informes","description":"Exportación de registros horarios en Excel y PDF (RD-ley 8/2019)."},{"name":"Fichaje","description":"Registro horario: iniciar/finalizar jornada, pausas e historial."}],"paths":{"/auth/register-manager":{"post":{"tags":["Autenticación"],"summary":"Registrar una empresa nueva","description":"Crea la empresa y a quien la registra como ADMIN de ese tenant. Es quien luego puede crear GESTOR/RRHH/otros ADMIN.","operationId":"registerManager","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterManagerRequest"}}},"required":true},"responses":{"200":{"description":"Empresa creada, tokens emitidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthenticationResponse"}}}},"400":{"description":"Datos inválidos (email, nombre o contraseña)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"409":{"description":"Ya existe una empresa con ese nombre","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"429":{"description":"Demasiados intentos desde esta IP","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/auth/refresh":{"post":{"tags":["Autenticación"],"summary":"Renovar el access token","description":"Emite un access token nuevo a partir de un refresh token vivo. Reutiliza el mismo refresh token.","operationId":"refresh","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshTokenRequest"}}},"required":true},"responses":{"200":{"description":"Access token renovado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthenticationResponse"}}}},"400":{"description":"refreshToken en blanco","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"Refresh token inexistente, revocado o caducado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/auth/logout":{"post":{"tags":["Autenticación"],"summary":"Cerrar sesión","description":"Revoca el refresh token indicado. Idempotente: si el token no existe, no lanza error ni revela nada.","operationId":"logout","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshTokenRequest"}}},"required":true},"responses":{"200":{"description":"Sesión cerrada (o ya lo estaba)"},"400":{"description":"refreshToken en blanco","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/auth/login":{"post":{"tags":["Autenticación"],"summary":"Iniciar sesión","description":"Devuelve un access token (15 min) y un refresh token (30 días).","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"Login correcto","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthenticationResponse"}}}},"400":{"description":"Email o contraseña en blanco / email mal formado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"Credenciales incorrectas, o usuario dado de baja","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"429":{"description":"Demasiados intentos desde esta IP","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/v1/usuario/cambiar-contrasena":{"post":{"tags":["Usuario"],"summary":"Cambiar la contraseña propia","description":"Exige la contraseña antigua.","operationId":"changePassword","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangePasswordRequest"}}},"required":true},"responses":{"200":{"description":"Contraseña cambiada"},"400":{"description":"Contraseña nueva demasiado corta, o la contraseña antigua no coincide","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/gestor/gestores":{"post":{"tags":["Gestión"],"summary":"Crear un gestor","description":"Solo ADMIN: antes cualquier GESTOR podía crear otro sin límite.","operationId":"createManager","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateManagerRequest"}}},"required":true},"responses":{"200":{"description":"Gestor creado"},"400":{"description":"Datos inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'gestor:crear' (solo ADMIN la tiene)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"409":{"description":"El email ya está registrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/gestor/empleados":{"post":{"tags":["Gestión"],"summary":"Crear un empleado","description":"En la empresa de quien lo crea. Rol EMPLEADO fijo.","operationId":"createEmployee","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateEmployeeRequest"}}},"required":true},"responses":{"200":{"description":"Empleado creado"},"400":{"description":"Datos inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'empleado:crear'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"409":{"description":"El email ya está registrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/fichaje":{"post":{"tags":["Fichaje"],"summary":"Fichar (INICIO/FIN/PAUSA_INICIO/PAUSA_FIN)","description":"Avanza la máquina de estados del fichaje del usuario autenticado.","operationId":"registerTimeEntry","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimeEntryRequest"}}},"required":true},"responses":{"200":{"description":"Fichaje registrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TimeEntryResponse"}}}},"400":{"description":"'tipo' ausente o inválido","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'fichaje:escribir'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"409":{"description":"Transición inválida (ej. iniciar con una jornada ya activa, pausar sin jornada...)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/ausencias":{"post":{"tags":["Ausencias"],"summary":"Solicitar una ausencia","description":"Se crea en estado PENDIENTE.","operationId":"requestAbsence","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AbsenceRequestDTO"}}},"required":true},"responses":{"200":{"description":"Petición creada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AbsenceResponse"}}}},"400":{"description":"Datos inválidos, o fechaInicio posterior a fechaFin","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'ausencia:escribir'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/gestor/empleados/{id}/estado":{"patch":{"tags":["Gestión"],"summary":"Activar o dar de baja a un empleado","description":"Un empleado dado de baja no puede autenticarse, pero sus fichajes/ausencias pasadas se conservan (requisito legal, no se borran).","operationId":"updateEmployeeStatus","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateEmployeeStatusRequest"}}},"required":true},"responses":{"200":{"description":"Estado actualizado"},"400":{"description":"Falta el campo 'activo'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin authority, o empleado de otra empresa (aislamiento multi-tenant)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"404":{"description":"Empleado no encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/fichaje/{id}":{"patch":{"tags":["Fichaje"],"summary":"Corregir un fichaje pasado (RRHH/ADMIN)","description":"Nunca sobrescribe: anula el fichaje original y crea uno nuevo con los valores corregidos, enlazado al original. Solo sobre fichajes ya cerrados (con horaSalida). Queda una traza completa en /api/v1/auditoria/fichaje/{id} (ver AuditController).","operationId":"correctTimeEntry","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimeEntryCorrectionRequest"}}},"required":true},"responses":{"200":{"description":"Fichaje corregido (se devuelve el nuevo, no el original)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TimeEntryResponse"}}}},"400":{"description":"Datos inválidos, o horaSalida no posterior a horaEntrada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'fichaje:corregir', o fichaje de otra empresa (aislamiento multi-tenant)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"404":{"description":"Fichaje no encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"409":{"description":"El fichaje está activo (sin cerrar) o ya fue corregido antes","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/ausencias/{id}/estado":{"patch":{"tags":["Ausencias"],"summary":"Aprobar o rechazar una petición de ausencia","description":"Solo si está PENDIENTE y es de la empresa del gestor. Deja constancia de quién resolvió y cuándo. Al RECHAZAR, el comentario es obligatorio.","operationId":"updateRequestStatus","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateAbsenceStatusRequest"}}},"required":true},"responses":{"200":{"description":"Petición resuelta","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AbsenceResponse"}}}},"400":{"description":"Estado ausente/inválido, o rechazo sin comentario","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin authority, o petición de otra empresa (aislamiento multi-tenant)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"404":{"description":"Petición no encontrada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"409":{"description":"La petición ya no está PENDIENTE","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/informes/mensual/{empleadoId}":{"get":{"tags":["Informes"],"summary":"Informe mensual de un empleado en PDF","description":"El registro de jornada individual que exige el RD-ley 8/2019, con el detalle diario, el total del mes y espacio para las firmas del trabajador y de la empresa.","operationId":"exportarInformeMensualEnPdf","parameters":[{"name":"empleadoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"anio","in":"query","description":"Año del informe","required":true,"schema":{"type":"integer","format":"int32","maximum":2100,"minimum":2000}},{"name":"mes","in":"query","description":"Mes del informe (1-12)","required":true,"schema":{"type":"integer","format":"int32","maximum":12,"minimum":1}}],"responses":{"200":{"description":"Documento PDF","content":{"application/pdf":{}}},"400":{"description":"Mes o año fuera de rango","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin authority, o empleado de otra empresa","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"404":{"description":"Empleado no encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/informes/horas":{"get":{"tags":["Informes"],"summary":"Excel de horas de la empresa","description":"Todas las jornadas cerradas de la empresa en el mes indicado, con sus totales. Las jornadas cerradas automáticamente por el sistema aparecen marcadas.","operationId":"exportarHorasEnExcel","parameters":[{"name":"anio","in":"query","description":"Año del informe","required":true,"schema":{"type":"integer","format":"int32","maximum":2100,"minimum":2000}},{"name":"mes","in":"query","description":"Mes del informe (1-12)","required":true,"schema":{"type":"integer","format":"int32","maximum":12,"minimum":1}}],"responses":{"200":{"description":"Hoja de cálculo .xlsx","content":{"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet":{}}},"400":{"description":"Mes o año fuera de rango","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'informe:exportar' (RRHH/ADMIN)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/gestor/mis-empleados":{"get":{"tags":["Gestión"],"summary":"Listar mis empleados","description":"Los EMPLEADO de la empresa de quien pregunta.","operationId":"getMyEmployees","responses":{"200":{"description":"Listado de empleados","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/SimpleEmployeeDTO"}}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'empleado:leer'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/gestor/ausencias-historial":{"get":{"tags":["Gestión"],"summary":"Historial de ausencias del equipo","description":"Todas las que ya no están PENDIENTE.","operationId":"getAbsenceHistory","responses":{"200":{"description":"Historial de ausencias","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AbsenceResponse"}}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'ausencia:leer:equipo'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/fichaje/historial":{"get":{"tags":["Fichaje"],"summary":"Historial de fichajes propio","description":"Los últimos 200, más recientes primero.","operationId":"getHistory","responses":{"200":{"description":"Historial","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TimeEntryResponse"}}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'fichaje:leer'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/fichaje/gestor/historial":{"get":{"tags":["Fichaje"],"summary":"Historial de fichajes del equipo (gestor)","description":"Solo los EMPLEADO de la empresa del gestor autenticado, nunca otros gestores.","operationId":"getTeamHistory","responses":{"200":{"description":"Historial del equipo","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TeamTimeEntryDTO"}}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'fichaje:leer:equipo'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/fichaje/activo":{"get":{"tags":["Fichaje"],"summary":"Consultar la jornada activa","description":"204 si no hay ninguna jornada abierta.","operationId":"getActiveTimeEntry","responses":{"200":{"description":"Jornada activa","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TimeEntryResponse"}}}},"204":{"description":"No hay jornada activa","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TimeEntryResponse"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'fichaje:leer'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/dashboard/resumen":{"get":{"tags":["Dashboard"],"summary":"Mi resumen","description":"Minutos trabajados hoy, esta semana y este mes (descontando pausas), estado de fichaje actual, ausencias pendientes y saldo de vacaciones. Los periodos se calculan en hora española, no en UTC.","operationId":"getPersonalDashboard","responses":{"200":{"description":"Resumen del usuario autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PersonalDashboardResponse"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'fichaje:leer'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/dashboard/empresa":{"get":{"tags":["Dashboard"],"summary":"Resumen de la empresa (gestor)","description":"Agregados del mes en curso para la empresa del gestor: empleados activos, minutos totales, ausencias por aprobar, incidencias de fichaje sin corregir y horas por empleado.","operationId":"getCompanyDashboard","responses":{"200":{"description":"Resumen de la empresa","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CompanyDashboardResponse"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'fichaje:leer:equipo'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/ausencias/saldo-vacaciones":{"get":{"tags":["Ausencias"],"summary":"Mi saldo de vacaciones","description":"Días de vacaciones a los que se tiene derecho ese año, consumidos y disponibles. Los consumidos se calculan sobre las peticiones ya APROBADAS, en días hábiles.","operationId":"getMyVacationBalance","parameters":[{"name":"anio","in":"query","description":"Año a consultar. Por defecto, el actual.","required":false,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"Saldo del año indicado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/VacationBalanceResponse"}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'ausencia:leer'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/ausencias/mis-peticiones":{"get":{"tags":["Ausencias"],"summary":"Mis peticiones de ausencia","description":"Todas, en cualquier estado.","operationId":"getMyRequests","responses":{"200":{"description":"Peticiones del usuario","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AbsenceResponse"}}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'ausencia:leer'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/ausencias/gestor/pendientes":{"get":{"tags":["Ausencias"],"summary":"Peticiones pendientes del equipo (gestor)","operationId":"getPendingRequests","responses":{"200":{"description":"Peticiones PENDIENTE de la empresa del gestor","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AbsenceResponse"}}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'ausencia:aprobar'","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}},"/api/v1/auditoria/fichaje/{id}":{"get":{"tags":["Auditoría"],"summary":"Línea temporal de un fichaje","description":"Todas las entradas de auditoría de ese fichaje, más antigua primero: su creación, sus modificaciones (fin de jornada, pausas) y, si la hubo, su corrección.","operationId":"getAuditTrail","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Línea temporal (vacía si el fichaje no tiene cambios registrados)","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TimeEntryAuditResponse"}}}}},"401":{"description":"No autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"403":{"description":"Sin la authority 'fichaje:auditoria', o fichaje de otra empresa (aislamiento multi-tenant)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"404":{"description":"Fichaje no encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}},"security":[{"bearerAuth":[]}]}}},"components":{"schemas":{"RegisterManagerRequest":{"type":"object","properties":{"nombreEmpresa":{"type":"string","minLength":1},"nombreGestor":{"type":"string","minLength":1},"email":{"type":"string","format":"email","minLength":1},"password":{"type":"string","maxLength":2147483647,"minLength":6}},"required":["email","nombreEmpresa","nombreGestor","password"]},"AuthenticationResponse":{"type":"object","properties":{"token":{"