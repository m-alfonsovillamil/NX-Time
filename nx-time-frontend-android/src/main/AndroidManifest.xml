<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        Recordatorio de fichar (paso 7). Desde Android 13 notificar exige
        permiso del usuario, y se pide AL ACTIVAR el recordatorio, no al
        arrancar la aplicación: un permiso que se pide sin que se vea para
        qué es un permiso que se deniega.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
        allowBackup="false": la copia de seguridad automática de Android
        se lleva el directorio de SharedPreferences a Google Drive, y ahí
        vive NXTIME_PREFS con el access token y el refresh token, que
        dura 30 dias. Con la copia activada, ese refresh token sale del
        dispositivo y ademas se puede extraer con "adb backup". Para una
        aplicacion de registro horario con valor legal, no compensa.

        Las dos reglas de extraccion cubren lo mismo en las versiones
        nuevas: dataExtractionRules es para Android 12+ y
        fullBackupContent para las anteriores.
    -->
    <application
            android:name=".NxTimeApplication"
            android:allowBackup="false"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.NxTime"
            android:networkSecurityConfig="@xml/network_security_config">

        <!--
            Sentry (paso 5 del piloto) se arranca a mano en
            NxTimeApplication y no con su ContentProvider automatico: asi,
            sin DSN (en desarrollo o en el CI), no se inicializa nada, en
            vez de arrancar y quejarse de que falta.
        -->
        <meta-data
                android:name="io.sentry.auto-init"
                android:value="false" />

        <!--
            Una sola Activity: desde la reescritura en Compose la
            navegacion la lleva navigation-compose, asi que las doce
            entradas que habia aqui (una por pantalla) ya no existen.
        -->
        <activity
                android:name=".MainActivity"
                android:exported="true"
                android:windowSoftInputMode="adjustResize"
                android:theme="@style/Theme.NxTime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FileProvider para los informes descargados (Excel y PDF).

            Los informes se guardan en la cache de la app, no en la
            carpeta de descargas: llevan datos personales de toda la
            plantilla y ahi los leeria cualquier app con permiso de
            lectura. Este proveedor concede acceso a un fichero concreto,
            solo a la app que el usuario elija para abrirlo y solo
            mientras dure el intent.

            grantUriPermissions es lo que hace posible esa cesion
            temporal; exported="false" impide que nadie llame al
            proveedor por su cuenta.
        -->
        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.informes"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/rutas_de_informes" />
        </provider>

        <!--
            Push (Fase B5, ADR 028). Los mensajes son solo de datos, así que
            siempre pasan por aquí y es la app la que decide si los enseña
            (con sesión y con el ajuste encendido) y cómo.
        -->
        <service
                android:name=".push.NxTimeMessagingService"
                android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            Sin esto, Firebase pide un token a Google en el primer arranque,
            lo quiera o no quien usa la app. Los push van apagados por
            defecto: el token se pide al encenderlos en Ajustes.
        -->
        <meta-data
                android:name="firebase_messaging_auto_init_enabled"
                android:value="false" />
    </application>

</manifest>
