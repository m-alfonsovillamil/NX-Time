<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.nxtime.app">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
            android:name=".NxTimeApplication"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.NxTime"
            android:networkSecurityConfig="@xml/network_security_config">

        <activity
                android:name=".MainActivity"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
                android:name=".ui.login.HomeActivity"
                android:exported="false" />

        <activity
                android:name=".ui.historial.HistorialActivity"
                android:exported="false" />

        <activity
                android:name=".ui.solicitud.SolicitudActivity"
                android:exported="false" />

        <activity
                android:name=".ui.ausencias.AusenciasActivity"
                android:exported="false" />

        <activity
                android:name=".ui.gestor.GestorActivity"
                android:exported="false" />

        <activity
                android:name=".ui.gestor.historial.GestorHistorialActivity"
                android:exported="false" />

        <activity
                android:name=".ui.gestor.ManagerHomeActivity"
                android:exported="false" />

        <activity
                android:name=".ui.login.RegistroEmpresaActivity"
                android:exported="false" />

        <activity
                android:name=".ui.gestor.CrearEmpleadoActivity"
                android:exported="false" />

        <activity
                android:name=".ui.usuario.CambiarContrasenaActivity"
                android:exported="false" />

        <activity
                android:name=".ui.gestor.ausencias.GestorAusenciasAprobadasActivity"
                android:exported="false" />

        <activity
                android:name=".ui.gestor.CrearGestorActivity"
                android:exported="false" />
    </application>

</manifest>