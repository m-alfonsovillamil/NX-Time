<?xml version="1.0" encoding="utf-8"?>
<!--
    Lo unico que el FileProvider puede ceder: la subcarpeta "informes"
    de la cache de la app.

    Deliberadamente NO se declara la cache entera ni "files": un
    FileProvider con la raiz abierta permitiria ceder por error cualquier
    fichero interno, incluidas las SharedPreferences donde vive el
    refresh token.
-->
<paths>
    <cache-path name="informes" path="informes/" />
    <!--
        Los adjuntos (el CV) van a su propia subcarpeta y no a la de
        informes: son documentos distintos, y una carpeta por cosa hace
        que borrar la caché de una no se lleve la otra por delante.
        Sigue sin declararse la caché entera, por lo mismo que arriba.
    -->
    <cache-path name="adjuntos" path="adjuntos/" />
</paths>
