<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="16dp"
        android:paddingHorizontal="16dp"
        android:background="@color/app_background_grey_claro"
        tools:context=".ui.login.HomeActivity">

    <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            tools:text="Hola, Miguel Alfonso" />

    <TextView
            android:id="@+id/tvHoraInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvBienvenida"
            android:layout_centerHorizontal="true"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            tools:text="Toca para iniciar tu jornada" />


    <LinearLayout
            android:id="@+id/bottom_button_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true"
            android:paddingBottom="16dp"
            android:layout_marginHorizontal="16dp">

        <Button
                android:id="@+id/btnPanelGestor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_panel_gestor"
                android:visibility="gone"
                tools:visibility="visible"
                android:layout_marginBottom="8dp"
                android:backgroundTint="?attr/colorSecondary"
                android:textColor="?attr/colorOnSecondary" />

        <Button
                android:id="@+id/btnSolicitarAusencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_solicitar_ausencia"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginBottom="8dp"
                android:textColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorPrimary" />

        <Button
                android:id="@+id/btnVerAusencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_ver_ausencias"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginBottom="8dp"
                android:textColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorPrimary" />

        <Button
                android:id="@+id/btnVerHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_ver_historial"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginBottom="8dp"
                android:textColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorPrimary" />

        <Button
                android:id="@+id/btnCambiarContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_cambiar_contrasena"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginBottom="24dp"
                android:textColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorPrimary" />

        <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cerrar Sesión"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="?attr/colorError" />
    </LinearLayout>


    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/tvHoraInicio"
            android:layout_above="@id/bottom_button_container"
            android:fillViewport="true">

        <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="24dp">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFichar"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_centerInParent="true"
                    android:text="@string/home_iniciar_jornada"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="110dp"
                    android:textColor="?attr/colorOnPrimary" />

            <Button
                    android:id="@+id/btnPausa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/btnFichar"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="24dp"
                    android:text="@string/home_iniciar_pausa"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:textColor="?attr/colorOnPrimary"
                    android:backgroundTint="?attr/colorPrimary" />

        </RelativeLayout>
    </ScrollView>

</RelativeLayout>