<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background_grey_claro"
        tools:context=".ui.gestor.ManagerHomeActivity">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel de Gestor"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="32dp" />

        <Button
                android:id="@+id/btnGestionarAusencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gestionar Solicitudes Pendientes"
                android:paddingVertical="14dp"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary"/>

        <Button
                android:id="@+id/btnVerHistorialEquipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ver Historial de Fichajes"
                android:paddingVertical="14dp"
                android:textSize="16sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorPrimary"
                android:layout_marginBottom="16dp"/>

        <Button
                android:id="@+id/btnVerAusenciasAprobadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gestor_ver_ausencias_aprobadas"
                android:paddingVertical="14dp"
                android:textSize="16sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorPrimary"/>

        <Button
                android:id="@+id/btnCrearGestor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crear Nuevo Gestor"
                android:layout_marginBottom="8dp"
                android:backgroundTint="?attr/colorSecondary"
                android:textColor="?attr/colorOnSecondary" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_crear_empleado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            app:srcCompat="@android:drawable/ic_input_add"
            app:backgroundTint="?attr/colorSecondary"
            app:tint="?attr/colorOnSecondary"
            android:contentDescription="Añadir nuevo empleado" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>